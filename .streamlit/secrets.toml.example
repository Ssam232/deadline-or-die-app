# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App settings → Secrets.

APP_PASSWORD = "pick-something"                 # gate so nobody else sees your tasks/proof
NOTION_TOKEN = "ntn_..."                        # notion.so/profile/integrations → your integration's secret
NOTION_PARENT_PAGE = "https://www.notion.so/Deadline-or-Die-..."   # the page you connected the integration to
NTFY_TOPIC = "dod-<long-random-string>"          # pick something unguessable; subscribe to it in the ntfy app
APP_URL = "https://your-app.streamlit.app"      # tapping a notification opens this
# ANTHROPIC_API_KEY = "sk-ant-..."              # optional: AI race steward + goal breakdowns
PLAYER_NAME = "Driver"                         # what the app calls you (first launch only)
# STARTER_GOALS = [["Finish the thesis", "Why it matters"], ["Another goal", "Why"]]   # one-click goals
